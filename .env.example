# =============================================================================
# EXAMCHAIN — Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# All values below are DEVELOPMENT DEFAULTS only.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=examchain
POSTGRES_USER=examchain
POSTGRES_PASSWORD=change_me_in_dev

# -----------------------------------------------------------------------------
# Spring Boot Backend
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/examchain
SPRING_DATASOURCE_USERNAME=examchain
SPRING_DATASOURCE_PASSWORD=change_me_in_dev
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
EXAMCHAIN_CORS_ORIGINS=http://localhost:5173

# =============================================================================
# PHASE 2+ (not used in Phase 1, documented for reference)
# =============================================================================

# Keycloak (Phase 2)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=change_me_in_dev
# KC_HTTP_PORT=8180

# MinIO (Phase 4)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change_me_in_dev

# Vault (Phase 4) — Dev mode token, NEVER use in production
# VAULT_DEV_ROOT_TOKEN_ID=dev-only-token
# VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200

